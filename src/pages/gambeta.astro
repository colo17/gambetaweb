---
/**
 * LA PÁGINA DEL MUNDO GAMBETA
 *
 * Todo lo que es del MUNDO y no de un juego en particular: las competiciones,
 * los clubes, los planteles y las figuras. Los tres juegos comparten este
 * catálogo, así que vive en su propia página y no colgando del Manager, que es
 * donde estaba hasta agosto de 2026.
 *
 * ⚠ SOBRE LOS NOMBRES: "Prenier League", "Arsenel", "Erlinj Haaland". El juego
 *   muta los nombres reales una letra por una cuestión de derechos y acá se
 *   muestra lo mismo que ve el jugador. No son erratas.
 */
import Base from '@/layouts/Base.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import MundoLigas from '@/components/MundoLigas.astro'
import MundoFiguras from '@/components/MundoFiguras.astro'
import SumaTuEquipo from '@/components/SumaTuEquipo.astro'
import PlantelExplorer from '@/components/PlantelExplorer.tsx'
import Simbolos from '@/components/Simbolos.astro'
import ligas from '@/data/ligas.json'
import numeros from '@/data/numeros.json'

const n = (valor: number) => valor.toLocaleString('es-AR')

/** Lo mínimo para el desplegable de ligas. Ver la nota de `MundoLigas`. */
const ligasParaIsla = ligas.map((liga) => ({
  slug: liga.slug,
  nombre: liga.nombre,
  pais: liga.pais,
  paisNombre: liga.paisNombre,
}))

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'El catálogo de Gambeta',
  description: `El mundo compartido por los juegos de Gambeta: ${numeros.ligas} ligas, ${numeros.clubes} clubes y ${numeros.jugadores} futbolistas.`,
  inLanguage: 'es',
  creator: { '@type': 'Organization', name: 'Gambeta' },
  keywords: ['fútbol', 'ligas', 'clubes', 'futbolistas', 'juego de fútbol'],
}
---

<Base
  titulo="El mundo Gambeta — 81 ligas, 1.339 clubes y 37.000 futbolistas"
  descripcion="Metete en el catálogo que comparten todos los juegos de Gambeta: explorá las 81 ligas, mirá los planteles club por club y buscá a cualquiera de los 37.000 futbolistas."
  schema={schema}
>
  <Header />
  <main id="contenido">
    <!-- ---- Presentación --------------------------------------------- -->
    <section class="relative isolate grano bg-carbon-950 pt-28 pb-16 md:pt-36 md:pb-20">
      <Simbolos semilla={2} />
      <div class="contenedor">
        <div class="max-w-3xl">
          <p class="rotulo">El mundo</p>
          <h1 class="mt-5 text-[clamp(2.5rem,7vw,5rem)]">
            Un mundo entero,<br /><span class="texto-degrade">compartido por los tres juegos</span>
          </h1>
          <p class="mt-7 text-lg leading-relaxed text-hueso-400">
            El mismo club que dirigís en el Manager es el que vas a defender en
            el Player Game y el que te van a preguntar en el Test. Un solo
            catálogo, armado a mano, con las ligas de verdad: sus divisiones,
            sus fechas, sus descensos y sus planteles.
          </p>
        </div>

        <dl class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-white/8 bg-white/8 md:grid-cols-4">
          {
            [
              { v: n(numeros.ligas), e: 'ligas oficiales' },
              { v: n(numeros.clubes), e: 'clubes' },
              { v: n(numeros.jugadores), e: 'futbolistas' },
              { v: n(numeros.paises), e: 'países' },
            ].map((dato) => (
              <div class="dato-hover bg-carbon-900 px-5 py-6">
                <dt class="dato-valor font-display text-4xl text-hueso-50 md:text-5xl">{dato.v}</dt>
                <dd class="mt-1.5 text-xs uppercase tracking-[0.16em] text-hueso-500">{dato.e}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ---- Las ligas -------------------------------------------------- -->
    <MundoLigas />

    <!-- ---- Los planteles ----------------------------------------------- -->
    <section id="jugadores" class="scroll-mt-24 border-t border-white/5 bg-carbon-900 py-20 md:py-28">
      <div class="contenedor">
        <div class="mb-8 max-w-2xl">
          <p class="rotulo">Club por club</p>
          <h2 class="mt-3 text-[clamp(1.75rem,4vw,3rem)]">
            Fijate quién juega en el tuyo
          </h2>
          <p class="mt-3 text-hueso-400">
            El plantel completo de los {n(numeros.clubes)} clubes, con la fuerza,
            el techo y la edad de cada uno. O escribí un nombre y lo buscamos en
            toda la liga.
          </p>
        </div>

        {/*
          ⚑ `client:visible`: la isla no se hidrata hasta que la sección entra en
            pantalla, y recién ahí pide el JSON de la primera liga. El que llega
            a esta página buscando las competiciones no paga nada por esto.
        */}
        <PlantelExplorer
          client:visible
          ligas={ligasParaIsla}
          slugInicial={ligas[0].slug}
        />

        <p class="mt-4 text-xs leading-relaxed text-hueso-500">
          La fuerza es el valor con el que el juego resuelve los partidos; el
          techo es hasta dónde puede llegar ese jugador si lo hacés crecer.
        </p>
      </div>
    </section>

    <!-- ---- Las figuras -------------------------------------------------- -->
    <MundoFiguras />

    <!-- ---- Sumá tu equipo ----------------------------------------------- -->
    <SumaTuEquipo />
  </main>
  <Footer />
</Base>
