---

<section
  id="camino"
  class="relative isolate grano scroll-mt-24 border-t border-white/5 bg-carbon-950 py-24 md:py-32"
>
  {/*
    ⚑ ESTA SECCIÓN NO LLEVA FONDO, Y ES A PROPÓSITO.

    Se probaron cuatro y las cuatro se veían raras:

      1. una foto estirada al alto del bloque — más de 10.000px de largo, salía
         deformada;
      2. un video con los fotogramas atados al scroll — dejó de deformarse pero
         seguía tosco: una foto oscura y ruidosa atenuada da manchones;
      3. un fondo dibujado por recorrido — dos costuras: franjas oscuras a los
         costados (vivía dentro de `.contenedor`) y un corte horizontal al pasar
         de un bloque al otro;
      4. una sola capa a sangre con líneas de cal en SVG — sin costuras, pero
         las líneas recortadas se leían como rayas sueltas, no como una cancha.

    La quinta es no poner nada. El carbón liso es lo que usan Manager y Juegos,
    así que además queda coherente, y las capturas del juego —que son el punto
    de la sección— quedan como lo único que se mira. El grano ya viene de la
    clase `grano` de la sección.

    ⚠ Si alguna vez se vuelve a intentar: el fondo NUNCA va dentro de
      `.contenedor` (deja franjas a los costados) y nada de degradés verticales
      pegados a la ventana (dibujan bandas fijas que no se mueven con el texto).
  */}
  <div class="contenedor">
    <header class="mx-auto mb-16 max-w-2xl text-center md:mb-24">
      <p class="rotulo">Tu camino en el juego</p>
      <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)]">
        De la sala vacía <span class="texto-degrade">a la vuelta</span>
      </h2>
      <p class="mt-5 text-lg text-hueso-400">
        Todas las pantallas son capturas del juego funcionando, no maquetas.
      </p>
    </header>

    {/* ---- RECORRIDO 1: EL CLUB -------------------------------------- */}
    <Recorrido etapas={etapas} />

    {/* ---- RECORRIDO 2: LA SELECCIÓN --------------------------------- */}
    <div class="linea-cal my-20 md:my-28"></div>

    <header class="mx-auto mb-16 max-w-2xl text-center md:mb-24">
      <p class="rotulo">La otra carrera</p>
      <h2 class="mt-4 text-[clamp(1.875rem,5vw,3.5rem)]">
        Si con tu club no fue suficiente,<br />
        <span class="texto-degrade">dirigí a tu selección</span>
      </h2>
    </header>

    <Recorrido etapas={etapasSeleccion} />
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const seccion = document.querySelector<HTMLElement>('#camino')

  /**
   * ⚑ HAY DOS RECORRIDOS EN LA MISMA SECCIÓN (el club y la selección), así que
   *   todas las búsquedas van ACOTADAS a su bloque. Con `document.querySelectorAll`
   *   el segundo pisaba al primero: al llegar a la selección se apagaban las
   *   imágenes del club y quedaba el marco vacío.
   */
  document.querySelectorAll<HTMLElement>('[data-recorrido]').forEach((bloque) => {
    const etapas = gsap.utils.toArray<HTMLElement>(bloque.querySelectorAll('[data-etapa]'))
    const figuras = gsap.utils.toArray<HTMLElement>(bloque.querySelectorAll('[data-camino-figura]'))
    const progreso = bloque.querySelector<HTMLElement>('[data-camino-progreso]')
    if (!etapas.length || !figuras.length) return

    /** Deja visible una sola figura. El cambio es un fundido corto. */
    const mostrar = (indice: number) => {
      figuras.forEach((figura, i) => {
        gsap.to(figura, { opacity: i === indice ? 1 : 0, duration: 0.45, ease: 'power2.out' })
      })
      etapas.forEach((etapa, i) => {
        const punto = etapa.querySelector<HTMLElement>('[data-etapa-punto]')
        if (!punto) return
        const activo = i === indice
        punto.classList.toggle('bg-cesped-500', activo)
        punto.classList.toggle('text-carbon-950', activo)
        punto.classList.toggle('border-cesped-500', activo)
        punto.classList.toggle('bg-carbon-900', !activo)
        punto.classList.toggle('text-cesped-400', !activo)
      })
    }

    etapas.forEach((etapa, indice) => {
      ScrollTrigger.create({
        trigger: etapa,
        // El disparo está a media pantalla: la etapa "manda" cuando su texto
        // está en el centro de la vista, que es donde lo lee la gente.
        start: 'top 55%',
        end: 'bottom 55%',
        onEnter: () => mostrar(indice),
        onEnterBack: () => mostrar(indice),
      })
    })

    mostrar(0)

    if (progreso) {
      gsap.to(progreso, {
        width: '100%',
        ease: 'none',
        scrollTrigger: { trigger: bloque, start: 'top 60%', end: 'bottom 80%', scrub: 0.5 },
      })
    }
  })
</script>
